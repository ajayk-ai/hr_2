# Copy to `.env.local`.

# Leave empty in development so requests go through the Vite proxy to
# 127.0.0.1:8000. Set to the API origin when the UI is deployed separately.
VITE_API_BASE_URL=

# Bearer token matching one of the backend's HRDOC_API_TOKENS.
# NOTE: anything in a VITE_ variable is embedded in the built JS bundle and is
# readable by anyone with the page. This is acceptable only for an internal tool
# behind SSO/VPN. For a public deployment, put the token in a server-side proxy.
VITE_API_TOKEN=
