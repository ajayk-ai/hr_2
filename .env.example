# Copy to `.env` for local development. Never commit the populated file.

# ---- Runtime ---------------------------------------------------------------
HRDOC_ENVIRONMENT=local
HRDOC_LOG_LEVEL=INFO
HRDOC_LOG_JSON=false
HRDOC_CORS_ORIGINS=http://localhost:5173

# ---- Server ------------------------------------------------------------
# Used by `uv run python -m app.main` (scripts/run.bat, scripts/register-task.ps1).
# Ignored if you invoke uvicorn directly with --host/--port instead.
HRDOC_HOST=0.0.0.0
HRDOC_PORT=8000

# Verify TLS against the OS certificate store instead of certifi's bundle. Keep
# this on behind a TLS-intercepting proxy or endpoint antivirus, whose private
# root CA certifi does not carry -- without it every outbound HTTPS call fails
# with CERTIFICATE_VERIFY_FAILED. Harmless elsewhere: the system store holds the
# same public roots.
HRDOC_USE_SYSTEM_TRUST_STORE=true

# ---- Auth ------------------------------------------------------------------
# Comma-separated bearer tokens. Leave empty locally; REQUIRED in production.
HRDOC_API_TOKENS=

# ---- Google Document AI ----------------------------------------------------
# Create a "Document OCR" processor: https://console.cloud.google.com/ai/document-ai
# Billing must be enabled on the project, even within the free tier.
HRDOC_GCP_PROJECT_ID=
# Must match the processor's region exactly, lowercase: us, eu, asia-south1, ...
HRDOC_DOCAI_LOCATION=us
HRDOC_DOCAI_PROCESSOR_ID=
# Optional: pin a processor version for reproducible extraction across deploys.
HRDOC_DOCAI_PROCESSOR_VERSION=
# Per-page image quality scores, used to warn about unreadable scans. Only some
# processor versions support it; the rest reject the whole request, so it is off.
HRDOC_DOCAI_IMAGE_QUALITY_SCORES=false

# Absolute path to a service account key with the "Document AI API User" role.
# Keep the file outside this repository. Leave empty to use Application Default
# Credentials instead -- `gcloud auth application-default login` locally, or
# Workload Identity on Cloud Run/GKE, which needs no key file at all.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey
HRDOC_GEMINI_API_KEY=
HRDOC_GEMINI_MODEL=gemini-2.5-flash
HRDOC_GEMINI_THINKING_BUDGET=0

# ---- Limits and tuning -----------------------------------------------------
HRDOC_MAX_FILES_PER_REQUEST=25
HRDOC_MAX_FILE_BYTES=20971520
HRDOC_MAX_TOTAL_BYTES=104857600
HRDOC_OCR_CONCURRENCY=5
HRDOC_LLM_CONCURRENCY=5
# Below MIN: filed as Unknown. Between MIN and REVIEW: filed as classified but
# listed in the report's `needs_review`. Above REVIEW: trusted.
HRDOC_MIN_CLASSIFICATION_CONFIDENCE=0.55
HRDOC_REVIEW_CONFIDENCE=0.75
HRDOC_MASK_SENSITIVE_IDS=true
